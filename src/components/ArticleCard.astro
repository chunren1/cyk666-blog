---
import { ArrowRight } from '@lucide/astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  slug: string;
}

const { title, date, description, tags, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="article-card">
  <a href={`/articles/${slug}/`} class="card-link">
    <!-- Spotlight radial gradient overlay -->
    <div class="card-spotlight"></div>
    <!-- Top accent line -->
    <div class="card-accent-line"></div>
    <div class="card-body">
      <div class="card-date-row">
        <time class="card-date" datetime={date.toISOString()}>{formattedDate}</time>
      </div>
      <h3 class="card-title">{title}</h3>
      {description && <p class="card-desc">{description}</p>}
      <div class="card-footer">
        {tags.length > 0 && (
          <div class="card-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
        <div class="card-arrow">
          <ArrowRight size={18} />
        </div>
      </div>
    </div>
  </a>
</article>

<script>
  function initArticleCards() {
    if (window.matchMedia('(hover: none)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLElement>('.article-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty('--mx', `${x}%`);
        card.style.setProperty('--my', `${y}%`);
      });
    });
  }

  // View Transitions 导航替换 DOM 后需重新绑定，不能用 DOMContentLoaded（只触发一次）
  document.addEventListener('astro:page-load', initArticleCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleCards);
  } else {
    initArticleCards();
  }
</script>

<style>
  .article-card {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    background: var(--color-bg-card);
    overflow: hidden;
    transform: translateY(0);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }

  .article-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    box-shadow:
      0 4px 16px rgba(33, 28, 21, 0.08),
      0 8px 32px color-mix(in srgb, var(--color-primary) 8%, transparent);
    transform: translateY(-4px);
  }

  /* ── Top accent line ── */
  .card-accent-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      color-mix(in srgb, var(--accent) 60%, transparent),
      var(--color-primary-light)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
    z-index: 2;
  }

  .article-card:hover .card-accent-line {
    transform: scaleX(1);
  }

  /* ── Spotlight overlay ── */
  .card-spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--color-primary) 6%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
    pointer-events: none;
    z-index: 1;
  }

  .article-card:hover .card-spotlight {
    opacity: 1;
  }

  .article-card:hover .card-title {
    color: var(--color-primary);
  }

  /* ── Link wrapper ── */
  .card-link {
    display: block;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  /* ── Date with orange separator dot ── */
  .card-date-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .card-date-row::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    flex-shrink: 0;
    opacity: 0.7;
  }

  .card-date {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-2);
    color: var(--color-text);
    line-height: var(--leading-snug);
    transition: color var(--duration-base) var(--ease-standard);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-4);
  }

  /* ── Tag pills with staggered hover brighten ── */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    display: inline-block;
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border-radius: var(--radius-full);
    font-weight: 500;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .article-card:hover .tag:nth-child(1) { transition-delay: 0ms; }
  .article-card:hover .tag:nth-child(2) { transition-delay: 30ms; }
  .article-card:hover .tag:nth-child(3) { transition-delay: 60ms; }
  .article-card:hover .tag:nth-child(4) { transition-delay: 90ms; }
  .article-card:hover .tag:nth-child(5) { transition-delay: 120ms; }

  .article-card:hover .tag {
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  /* ── Arrow with enhanced ease + slight scale ── */
  .card-arrow {
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    transition:
      color var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }

  .article-card:hover .card-arrow {
    color: var(--color-primary);
    transform: translateX(4px) scale(1.1);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .article-card {
      transition: border-color var(--duration-fast) var(--ease-standard);
    }
    .article-card:hover {
      transform: none;
    }
    .card-accent-line {
      transform: scaleX(1);
      transition: none;
    }
    .card-spotlight {
      display: none;
    }
  }

  /* ── Touch devices: no tilt/spotlight, keep lift ── */
  @media (hover: none) {
    .card-spotlight {
      display: none;
    }
  }
</style>
