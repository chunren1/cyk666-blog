---
import { Music, Mail, Phone, ArrowUpRight } from '@lucide/astro';
import GithubIcon from './GithubIcon.astro';

const year = new Date().getFullYear();

const quickLinks = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/#articles' },
  { label: '项目', href: '/#projects' },
  { label: '关于', href: '/#about' },
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/chunren1', icon: 'github' },
  { label: 'vibeMusic', href: 'https://vibe.cyk666.top', icon: 'music' },
];

// 联系方式：明文展示，避免 mailto:/tel: 协议在无关联应用时点击无反应
const contactPlain = [
  { label: '1273616219@qq.com', icon: 'mail' },
  { label: '19128937931', icon: 'phone' },
];
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-columns">
      <!-- Column 1: Brand -->
      <div class="footer-col footer-brand">
        <p class="footer-name">KKstar</p>
        <p class="footer-bio">全栈开发者 · 音乐爱好者 · 用代码构建有趣的事</p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col">
        <h3 class="footer-col-title">快速链接</h3>
        <nav class="footer-nav" aria-label="页脚导航">
          {quickLinks.map((link) => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </nav>
      </div>

      <!-- Column 3: Social / External -->
      <div class="footer-col">
        <h3 class="footer-col-title">连接</h3>
        <nav class="footer-nav" aria-label="外部链接">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class="footer-link footer-link-external"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.icon === 'github' && <GithubIcon size={15} />}
              {link.icon === 'music' && <Music size={15} />}
              <span>{link.label}</span>
              <ArrowUpRight size={12} class="link-arrow" />
            </a>
          ))}
          {contactPlain.map((item) => (
            <span class="footer-link footer-link-plain">
              {item.icon === 'mail' && <Mail size={15} />}
              {item.icon === 'phone' && <Phone size={15} />}
              <span>{item.label}</span>
            </span>
          ))}
        </nav>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="footer-copy">&copy; {year} KKstar · 使用 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建 · 部署于 Cloudflare</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: none;
    padding: var(--space-10) 0 var(--space-6);
    margin-top: var(--space-16);
    background: var(--color-bg-elevated);
  }

  /* ── Gradient top border ── */
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-primary) 25%, transparent) 30%,
      color-mix(in srgb, var(--accent) 40%, transparent) 50%,
      color-mix(in srgb, var(--color-primary) 25%, transparent) 70%,
      transparent
    );
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ── Three-column layout ── */
  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 769px) {
    .footer-columns {
      grid-template-columns: 1.2fr 0.8fr 1fr;
      gap: var(--space-10);
    }
  }

  /* ── Column styles ── */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-1);
  }

  /* ── Brand column: gradient name ── */
  .footer-name {
    font-size: var(--text-lg);
    font-weight: 700;
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--accent),
      var(--color-primary-light)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: var(--tracking-display);
  }

  .footer-bio {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 280px;
  }

  /* ── Nav links with animated underline ── */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
    width: fit-content;
  }

  /* Animated underline */
  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  .footer-link-external {
    gap: var(--space-1);
  }

  /* 明文联系方式：无下划线动画、无箭头，仅图标+文本 */
  .footer-link-plain {
    gap: var(--space-1);
    cursor: default;
    user-select: all;
  }

  .footer-link-plain::after {
    display: none;
  }

  .link-arrow {
    opacity: 0;
    transform: translate(-2px, 2px);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }

  .footer-link:hover .link-arrow {
    opacity: 0.6;
    transform: translate(0, 0);
  }

  /* ── Bottom / Copyright ── */
  .footer-bottom {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-5);
    text-align: center;
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: 1.6;
  }

  .footer-copy a {
    color: var(--color-text-tertiary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .footer-copy a:hover {
    color: var(--color-primary);
  }

  /* ── Mobile adjustments ── */
  @media (max-width: 768px) {
    .footer {
      padding: var(--space-8) 0 var(--space-5);
    }

    .footer-inner {
      gap: var(--space-6);
    }

    .footer-brand {
      margin-bottom: var(--space-1);
    }

    /* 链接区横向单行排列，避免垂直堆叠成长串列表 */
    .footer-columns {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .footer-col {
      gap: var(--space-2);
    }

    .footer-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
      align-items: center;
    }

    /* 连接区图标+文字紧凑横排 */
    .footer-link {
      font-size: var(--text-sm);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .footer-link::after {
      transition: none;
    }
    .link-arrow {
      transition: none;
    }
  }
</style>
